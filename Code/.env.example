APP_NAME="Hệ thống Helpdesk SLA"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
BUILD_ID="local"

# Tạo giá trị mới bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
JWT_ALGORITHM="HS256"
JWT_ISSUER="helpdesk-sla"
JWT_AUDIENCE="helpdesk-sla-api"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_USER="helpdesk"
POSTGRES_PASSWORD="CHANGE_ME_LOCAL_ONLY"
POSTGRES_DB="helpdesk"
DATABASE_URL="postgresql+asyncpg://helpdesk:CHANGE_ME_LOCAL_ONLY@localhost:5432/helpdesk"
REDIS_URL="redis://localhost:6379/0"

LOGIN_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_SECONDS=300

# Tệp được lưu ngoài database; giới hạn cho phép từ 1 đến 50 MB.
ATTACHMENT_STORAGE_DIR="storage/attachments"
MAX_ATTACHMENT_SIZE_MB=10

# Chỉ dùng cục bộ cho scripts/seed_initial_data.py; không đặt mật khẩu thật ở file mẫu.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_FULL_NAME="System Administrator"
SEED_ADMIN_PASSWORD="CHANGE_ME_BEFORE_SEEDING"

# CV045: dùng chung cho hai tài khoản demo; đặt giá trị cục bộ tối thiểu 12 ký tự.
SEED_DEMO_PASSWORD="CHANGE_ME_BEFORE_SEEDING"
SEED_DEMO_REQUESTER_EMAIL="demo.requester@example.com"
SEED_DEMO_PROCESSOR_EMAIL="demo.processor@example.com"
